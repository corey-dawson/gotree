    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Debug: gotree list",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}",
            "args": ["list"],
            "cwd": "${workspaceFolder}",
            "env": {},
            "showLog": true
        },
        {
            "name": "Debug: gotree list (with args)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}",
            "args": ["list", "."],
            "cwd": "${workspaceFolder}",
            "env": {},
            "showLog": true
        },
        {
            "name": "Debug: Test files package",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/files",
            "args": ["-test.v"],
            "cwd": "${workspaceFolder}",
            "showLog": true
        },
        {
            "name": "Debug: Current file",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${fileDirname}"
        }
    ]
}